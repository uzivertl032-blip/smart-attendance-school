# ==========================================
# Chatbot Service Environment Configuration
# ==========================================

# Port layanan Node.js
PORT=3001

# -------------------------------------------------------------
# OPSI A: Menggunakan NVIDIA NIM (build.nvidia.com)
# Gunakan konfigurasi ini jika API Key Anda berawalan 'nvapi-':
# -------------------------------------------------------------
NOUS_API_BASE_URL=https://integrate.api.nvidia.com/v1
NOUS_API_KEY=nvapi-your_nvidia_api_key_here
NOUS_MODEL=meta/llama-3.2-11b-vision-instruct

# -------------------------------------------------------------
# OPSI B: Menggunakan Nous Research Portal (portal.nousresearch.com)
# Gunakan konfigurasi ini jika API Key Anda dari Nous Research Portal:
# -------------------------------------------------------------
# NOUS_API_BASE_URL=https://inference-api.nousresearch.com/v1
# NOUS_API_KEY=your_nous_api_key_here
# NOUS_MODEL=meta-llama/llama-3.3-70b-instruct

ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000,http://absensi-sekolah.test
